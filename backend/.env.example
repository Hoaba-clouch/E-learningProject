# CodeMind AI Campus - Backend Environment Configuration Example
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=codemind_ai
USE_MYSQL=true

# Google Gemini LLM Configuration (comma-separated keys for automatic round-robin rotation)
GEMINI_API_KEYS=your-gemini-key-1,your-gemini-key-2
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-3.1-flash-lite
GEMINI_TIMEOUT_SEC=10
